import cv2
import numpy as np
import matplotlib.pyplot as plt
import time
import requests

# -------------------------------
# LOAD REAL EYE IMAGE
# -------------------------------
# Using a specific high-res eye image from a stable source
image_url = 'https://picsum.photos/id/1054/1200/800'
headers = {'User-Agent': 'Mozilla/5.0'}

try:
    response = requests.get(image_url, headers=headers)
    response.raise_for_status()
    image_array = np.asarray(bytearray(response.content), dtype=np.uint8)
    img_bgr = cv2.imdecode(image_array, cv2.IMREAD_COLOR)
    img = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2RGB)
except Exception as e:
    print(f'Download failed: {e}. Falling back to internal sample.')
    from skimage import data
    img_raw = data.camera()
    img = cv2.cvtColor(img_raw, cv2.COLOR_GRAY2RGB)

# -------------------------------
# PROCESSING
# -------------------------------
# Serial
start = time.time()
gray_serial = np.zeros((img.shape[0], img.shape[1]))
for i in range(img.shape[0]):
    for j in range(img.shape[1]):
        r, g, b = img[i, j]
        gray_serial[i, j] = 0.299*r + 0.587*g + 0.114*b
serial_time = time.time() - start

# Parallel
start = time.time()
gray_parallel = np.dot(img[..., :3], [0.299, 0.587, 0.114])
parallel_time = time.time() - start

# Filters
kernel = np.ones((5,5)) / 25
blur = cv2.filter2D(gray_parallel, -1, kernel)
sobel_x = cv2.Sobel(gray_parallel, cv2.CV_64F, 1, 0)
sobel_y = cv2.Sobel(gray_parallel, cv2.CV_64F, 0, 1)
edges = np.sqrt(sobel_x**2 + sobel_y**2)

# -------------------------------
# DISPLAY
# -------------------------------
plt.figure(figsize=(15,8))
plt.subplot(2, 3, 1); plt.imshow(img); plt.title('Original Eye Image')
plt.subplot(2, 3, 2); plt.imshow(gray_parallel, cmap='gray'); plt.title('Grayscale')
plt.subplot(2, 3, 3); plt.imshow(blur, cmap='gray'); plt.title('Blurred')
plt.subplot(2, 3, 4); plt.imshow(edges, cmap='gray'); plt.title('Edges')
plt.tight_layout()
plt.show()

print(f'\nSpeedup: {serial_time/parallel_time:.1f}x')
